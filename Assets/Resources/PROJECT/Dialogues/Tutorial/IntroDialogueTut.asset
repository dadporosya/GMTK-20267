        m_Calls: []
  - nodeId: 3
    speakerId: 
    initialized: 0
    speakerIsThis: 0
    overWriteValues: 0
    text: or maybe they'll tear out every hair from your head and burn you along
      with them, turning the smoke left behind from you into clouds, which will become
      nothing more than adornments for the heavenly gates
    initFromScriptableObject: 0
    speaker: {fileID: 0}
    speakerGameObject: {fileID: 0}
    speakerName: 
    speakerPortrait: {fileID: 0}
