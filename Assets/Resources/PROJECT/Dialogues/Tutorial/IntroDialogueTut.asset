  - nodeId: 2
    speakerId: 
    initialized: 0
    speakerIsThis: 0
    overWriteValues: 0
    text: i don't know if they're waiting for you there. maybe they are, maybe they'll
      let you in.
    initFromScriptableObject: 0
    speaker: {fileID: 0}
    speakerGameObject: {fileID: 0}
    speakerName: 
    speakerPortrait: {fileID: 0}
    useSpriteAtlas: 0
