  - nodeId: 1
    speakerId: 
    initialized: 0
    speakerIsThis: 0
    overWriteValues: 0
    text: are you serious? you don't even know where we're going?
    initFromScriptableObject: 0
    speaker: {fileID: 0}
    speakerGameObject: {fileID: 0}
    speakerName: 
    speakerPortrait: {fileID: 0}
