  - nodeId: 4
    speakerId: 
    initialized: 0
    speakerIsThis: 0
    overWriteValues: 0
    text: i am not a judge, merely a keeper. but i know the precise coordinates of
      every scar on your body, every wrinkle and callus.
    initFromScriptableObject: 0
    speaker: {fileID: 0}
    speakerGameObject: {fileID: 0}
    speakerName: 
