      m_PersistentCalls:
        m_Calls: []
  - nodeId: 4
    speakerId: 
    initialized: 0
    speakerIsThis: 0
    overWriteValues: 0
    text: every sin has its own scent and taste, imperceptible to you mortals.
    initFromScriptableObject: 0
    speaker: {fileID: 0}
    speakerGameObject: {fileID: 0}
    speakerName: 
    speakerPortrait: {fileID: 0}
    useSpriteAtlas: 0
    spriteAtlas: []
    spriteId: 0
    _speakerVoiceClips: []
