  - nodeId: 2
    speakerId: 
    initialized: 0
    speakerIsThis: 0
    overWriteValues: 0
    text: we don't have much time, for the holy engine beneath the hood of the angelic
      taxi stirs the air faster than i search through my winding archives for reports
      of your foul little deeds.
    initFromScriptableObject: 0
    speaker: {fileID: 0}
    speakerGameObject: {fileID: 0}
    speakerName: 
    speakerPortrait: {fileID: 0}
    useSpriteAtlas: 0
