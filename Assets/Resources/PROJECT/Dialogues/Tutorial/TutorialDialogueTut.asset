    overWriteValues: 0
    text: 'in order: wrath, pride, greed, lust, gluttony, envy, sloth'
    initFromScriptableObject: 0
    speaker: {fileID: 0}
    speakerGameObject: {fileID: 0}
    speakerName: 
    speakerPortrait: {fileID: 0}
