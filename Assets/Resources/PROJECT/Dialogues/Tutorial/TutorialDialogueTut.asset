    onNodeEnd:
      m_PersistentCalls:
        m_Calls: []
  - nodeId: 5
    speakerId: 
    initialized: 0
    speakerIsThis: 0
    overWriteValues: 0
    text: but i sense it just as you once sensed, every single day, the smell of
      cigarette smoke that soaked into your pillow.
    initFromScriptableObject: 0
    speaker: {fileID: 0}
    speakerGameObject: {fileID: 0}
    speakerName: 
    speakerPortrait: {fileID: 0}
    useSpriteAtlas: 0
