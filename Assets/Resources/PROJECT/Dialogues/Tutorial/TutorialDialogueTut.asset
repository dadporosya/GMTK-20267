  - nodeId: 0
    speakerId: 
    initialized: 0
    speakerIsThis: 0
    overWriteValues: 0
    text: 'Placing the card on the table, it will fill the car''s interior with the
      scent of its sin, slowly dispersing my memories of your deeds. '
    initFromScriptableObject: 0
    speaker: {fileID: 0}
    speakerGameObject: {fileID: 0}
    speakerName: 
    speakerPortrait: {fileID: 0}
    useSpriteAtlas: 0
