        m_Calls: []
  - nodeId: 3
    speakerId: 
    initialized: 0
    speakerIsThis: 0
    overWriteValues: 0
    text: the ash of cigarettes and my advanced age hinder me from digging through
      your past, from finding, among millions of events spanning several decades,
      the very thing for which your earthly flesh might be rejected.
    initFromScriptableObject: 0
    speaker: {fileID: 0}
    speakerGameObject: {fileID: 0}
    speakerName: 
    speakerPortrait: {fileID: 0}
    useSpriteAtlas: 0
