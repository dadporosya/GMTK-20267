        m_Calls: []
  - nodeId: 1
    speakerId: 
    initialized: 0
    speakerIsThis: 0
    overWriteValues: 0
    text: 'To make things easier for you, I''ll display the density of the fog in
      my mind on the counter. '
    initFromScriptableObject: 0
    speaker: {fileID: 0}
    speakerGameObject: {fileID: 0}
    speakerName: 
    speakerPortrait: {fileID: 0}
    useSpriteAtlas: 0
    spriteAtlas: []
    spriteId: 0
    _speakerVoiceClips: []
