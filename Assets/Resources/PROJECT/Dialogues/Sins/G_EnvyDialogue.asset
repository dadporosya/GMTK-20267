    initialized: 0
    speakerIsThis: 0
    overWriteValues: 0
    text: "\u0442\u043E\u0433\u0434\u0430 \u0442\u044B \u043F\u043E\u043D\u044F\u043B,
      \u0447\u0442\u043E \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u043C\u043E\u043D\u0435\u0442
      \u0442\u044B \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043D\u0430\u0439\u0434\u0451\u0448\u044C,
      \u0432\u0435\u0434\u044C \u0438\u0445 \u0432\u0441\u0435\u0445 \u043F\u0435\u0440\u0432\u0435\u0435
      \u0443\u0432\u0438\u0434\u044F\u0442 \u0438 \u0437\u0430\u0431\u0435\u0440\u0443\u0442
      \u0443 \u0442\u0435\u0431\u044F \u0431\u0440\u043E\u0434\u044F\u0449\u0438\u0435
      \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u0446\u044B"
