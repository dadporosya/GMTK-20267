  - nodeId: 5
    speakerId: 
    initialized: 0
    speakerIsThis: 0
    overWriteValues: 0
    text: "\u043E\u043D\u0438 \u043F\u043E\u0442\u0440\u0430\u0442\u044F\u0442 \u0432\u0441\u0451
      \u043D\u0430 \u0441\u0438\u0433\u0430\u0440\u0435\u0442\u044B \u0432 \u043F\u043E\u043B\u0442\u043E\u0440\u0430
      \u0440\u0430\u0437\u0430 \u0432\u043A\u0443\u0441\u043D\u0435\u0435, \u0447\u0435\u043C
      \u0442\u0432\u043E\u0438, \u0438 \u044D\u0442\u0430 \u0440\u0430\u0437\u043D\u0438\u0446\u0430
      \u0432\u043E \u0432\u043A\u0443\u0441\u0435 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
      \u043F\u0435\u0440\u0435\u0431\u044C\u0451\u0442 \u0432 \u0442\u0432\u043E\u0451\u043C
      \u0440\u0442\u0443 \u0442\u0430\u0431\u0430\u0447\u043D\u044B\u0439 \u043F\u0440\u0438\u0432\u043A\u0443\u0441
      \u043E\u043A\u0443\u0440\u043A\u0430, \u0447\u0442\u043E \u0443\u0436\u0435
      \u043B\u0435\u0442\u0435\u043B \u0432\u0433\u043B\u0443\u0431\u044C \u044D\u0442\u0430\u0436\u0435\u0439"
