  - nodeId: 3
    speakerId: 
    initialized: 0
    speakerIsThis: 0
    overWriteValues: 0
    text: "\u0442\u044B \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u043B \u0435\u0451,
      \u043D\u0430\u0434\u0435\u044F\u0441\u044C, \u0447\u0442\u043E \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C
      \u0442\u044B \u043D\u0430\u0439\u0434\u0451\u0448\u044C \u0441\u0442\u043E\u043B\u044C\u043A\u043E
      \u043C\u043E\u043D\u0435\u0442, \u0447\u0442\u043E\u0431\u044B \u043A\u0443\u043F\u0438\u0442\u044C
      \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0439 \u0431\u0435\u0442\u043E\u043D\u043D\u044B\u0439
      \u0448\u0430\u0440, \u0447\u0442\u043E \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u0442
      \u0432\u0441\u0435 \u044D\u0442\u0438 \u0432\u044B\u0441\u043E\u043A\u043E\u043C\u0435\u0440\u043D\u044B\u0435
      \u0437\u0434\u0430\u043D\u0438\u044F, \u043E\u0431\u0441\u044B\u043F\u0430\u0432
      \u0433\u043E\u043B\u043E\u0432\u044B \u0438\u0445 \u0436\u0438\u043B\u044C\u0446\u043E\u0432
      \u0441\u0442\u0435\u043A\u043B\u044F\u043D\u043D\u044B\u043C \u0434\u043E\u0436\u0434\u0451\u043C"
