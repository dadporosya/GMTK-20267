  - nodeId: 6
    speakerId: 
    initialized: 0
    speakerIsThis: 0
    overWriteValues: 0
    text: "\u043A\u043E\u043B\u043A\u0430\u044F \u0443\u0445\u043C\u044B\u043B\u043A\u0430
      \u0431\u0435\u0437\u0434\u0443\u0448\u043D\u044B\u0445 \u0441\u0442\u043E\u043B\u0431\u043E\u0432
      \u043E\u043A\u0440\u0430\u0448\u0438\u0432\u0430\u043B\u0430 \u044D\u0442\u043E\u0442
      \u043F\u0440\u0438\u0432\u043A\u0443\u0441 \u0432 \u0442\u043E\u0448\u043D\u043E\u0442\u0432\u043E\u0440\u043D\u044B\u0435
      \u043E\u0442\u0442\u0435\u043D\u043A\u0438, \u043F\u043E\u043F\u043E\u043B\u043D\u044F\u044F
      \u0442\u0432\u043E\u044E \u0433\u043B\u043E\u0442\u043A\u0443 \u0440\u0432\u043E\u0442\u043D\u044B\u043C\u0438
      \u043C\u0430\u0441\u0441\u0430\u043C\u0438, \u0447\u0442\u043E \u0443\u0441\u043A\u043E\u0440\u044F\u043B\u0438\u0441\u044C
      \u0432 \u0432\u043E\u0437\u0434\u0443\u0448\u043D\u043E\u043C \u0442\u0430\u043D\u0446\u0435
      \u0438 \u043B\u0435\u0437\u043B\u0438 \u0432 \u0432\u043E\u043B\u043E\u0441\u044B
      \u043F\u0440\u043E\u0445\u043E\u0436\u0438\u0445 \u0441 \u0447\u0435\u043C\u043E\u0434\u0430\u043D\u0430\u043C\u0438
      \u0438\u0437 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
      \u043A\u043E\u0436\u0438"
