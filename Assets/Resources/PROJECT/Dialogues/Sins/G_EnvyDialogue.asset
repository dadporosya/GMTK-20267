  - nodeId: 2
    speakerId: 
    initialized: 0
    speakerIsThis: 0
    overWriteValues: 0
    text: "\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u0432\u0435\u0447\u0435\u0440\u0435\u043B\u043E,
      \u0438 \u0432 \u0442\u0432\u043E\u0451\u043C \u0437\u0435\u0432\u043A\u0435
      \u043F\u0440\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u043B\u0430
      \u043D\u043E\u0442\u043A\u0430 \u043D\u0435\u043A\u0440\u0430\u0441\u0438\u0432\u043E\u0433\u043E
      \u043B\u044E\u0431\u043E\u0432\u0430\u043D\u0438\u044F, \u043A\u043E\u0433\u0434\u0430
      \u0442\u044B \u043E\u043F\u0443\u0441\u0442\u0438\u043B \u0433\u043E\u043B\u043E\u0432\u0443
      \u0432\u043D\u0438\u0437 \u0438 \u0443\u0432\u0438\u0434\u0435\u043B \u043F\u043E\u0434
      \u0441\u0432\u043E\u0438\u043C\u0438 \u043D\u043E\u0433\u0430\u043C\u0438 17
      \u043C\u0435\u0442\u0440\u043E\u0432 \u043E\u0431\u043E\u0433\u0430\u0449\u0430\u044E\u0449\u0435\u0439
      \u043B\u0451\u0433\u043A\u0438\u0435 \u0442\u043E\u043B\u0449\u0438 \u043A\u0438\u0441\u043B\u043E\u0440\u043E\u0434\u0430
      \u0438 \u0441\u0432\u0435\u0440\u043A\u0430\u044E\u0449\u0443\u044E, \u043A\u0430\u043A
      \u0442\u0435 \u043D\u043E\u0432\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0438,
      \u043C\u043E\u043D\u0435\u0442\u043A\u0443"
