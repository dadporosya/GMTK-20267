  - nodeId: 1
    speakerId: 
    initialized: 0
    speakerIsThis: 0
    overWriteValues: 0
    text: "\u0437\u0430\u0432\u0438\u0441\u0430\u044F \u043D\u0430 \u043A\u0440\u044B\u0448\u0435
      \u043F\u0430\u043D\u0435\u043B\u044C\u043D\u044B\u0445 \u043F\u044F\u0442\u0438\u044D\u0442\u0430\u0436\u0435\u043A,
      \u0442\u044B \u0443\u0441\u0442\u0440\u0435\u043C\u0438\u043B \u0441\u0432\u043E\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434 \u0432\u0432\u0435\u0440\u0445 \u043D\u0430
      \u043F\u043E\u0437\u043E\u043B\u043E\u0447\u0435\u043D\u043D\u044B\u0435 \u043D\u043E\u0432\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0438,
      \u0447\u0442\u043E \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u043B\u0438
      \u0441\u043A\u0432\u043E\u0437\u044C \u0441\u0435\u0431\u044F \u0443\u043B\u044C\u0442\u0440\u0430\u0444\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u044B\u0435
      \u043B\u0443\u0447\u0438 \u0438 \u043E\u0431\u0435\u0437\u0437\u0430\u0440\u0430\u0436\u0438\u0432\u0430\u043B\u0438
      \u0438\u0445 \u043E\u0442 \u0437\u0430\u043F\u0430\u0445\u0430 \u0440\u0443\u0442\u0438\u043D\u043D\u044B\u0445
      \u043E\u0431\u044F\u0437\u0430\u043D\u043D\u043E\u0441\u0442\u0435\u0439"
    initFromScriptableObject: 0
    speaker: {fileID: 0}
    speakerGameObject: {fileID: 0}
