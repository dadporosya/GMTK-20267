    onNodeEnd:
      m_PersistentCalls:
        m_Calls: []
  - nodeId: 15
    speakerId: 
    initialized: 0
    speakerIsThis: 0
    overWriteValues: 0
    text: so, the haze of memory is clearing now, isn't it?
    initFromScriptableObject: 0
    speaker: {fileID: 0}
    speakerGameObject: {fileID: 0}
    speakerName: 
    speakerPortrait: {fileID: 0}
    useSpriteAtlas: 0
