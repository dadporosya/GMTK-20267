  - nodeId: 1
    speakerId: 
    initialized: 0
    speakerIsThis: 0
    overWriteValues: 0
    text: it was tuesday, around eight in the morning.
    initFromScriptableObject: 0
    speaker: {fileID: 0}
    speakerGameObject: {fileID: 0}
    speakerName: 
    speakerPortrait: {fileID: 0}
    useSpriteAtlas: 0
