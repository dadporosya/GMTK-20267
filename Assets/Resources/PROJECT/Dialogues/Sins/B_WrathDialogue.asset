    onNodeEnd:
      m_PersistentCalls:
        m_Calls: []
  - nodeId: 13
    speakerId: 
    initialized: 0
    speakerIsThis: 0
    overWriteValues: 0
    text: you left thousands of punctures and tunnels through its veins, shredding
      its tongue until it resembled the tentacles of an octopus.
    initFromScriptableObject: 0
    speaker: {fileID: 0}
    speakerGameObject: {fileID: 0}
    speakerName: 
    speakerPortrait: {fileID: 0}
    useSpriteAtlas: 0
