      m_PersistentCalls:
        m_Calls: []
  - nodeId: 8
    speakerId: 
    initialized: 0
    speakerIsThis: 0
    overWriteValues: 0
    text: Three. No more, no less.
    initFromScriptableObject: 0
    speaker: {fileID: 0}
