        m_Calls: []
  - nodeId: 6
    speakerId: 
    initialized: 0
    speakerIsThis: 0
    overWriteValues: 0
    text: when you were finished, you buried my face beneath bread crumbs, scraps
      of stale sausage, and the empty wrappers from the yogurts and cheese bars.
    initFromScriptableObject: 0
    speaker: {fileID: 0}
    speakerGameObject: {fileID: 0}
    speakerName: 
