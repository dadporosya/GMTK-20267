  - nodeId: 1
    speakerId: 
    initialized: 0
    speakerIsThis: 0
    overWriteValues: 0
    text: the blue glow from the refrigerator fell so grotesquely across your face,
      and i watched you from inside the trash bin, the one where you usually toss
      empty chip bags and the wrappings of wayward winds.
    initFromScriptableObject: 0
    speaker: {fileID: 0}
    speakerGameObject: {fileID: 0}
    speakerName: 
    speakerPortrait: {fileID: 0}
    useSpriteAtlas: 0
    spriteAtlas: []
    spriteId: 0
    _speakerVoiceClips: []
    material: {fileID: 0}
    onNodeStart:
      m_PersistentCalls:
        m_Calls: []
    onNodeEnd:
      m_PersistentCalls:
        m_Calls: []
  - nodeId: 2
    speakerId: 
    initialized: 0
    speakerIsThis: 0
    overWriteValues: 0
    text: 'the tips of my wings showed through the wire mesh, but all you saw was
      whatever might silence the bottomless void inside your head for another evening
      in front of the television.

'
    initFromScriptableObject: 0
    speaker: {fileID: 0}
    speakerGameObject: {fileID: 0}
    speakerName: 
    speakerPortrait: {fileID: 0}
    useSpriteAtlas: 0
