  - nodeId: 1
    speakerId: 
    initialized: 0
    speakerIsThis: 0
    overWriteValues: 0
    text: "\u043E\u0434\u043D\u0438\u043C \u0436\u0430\u0440\u043A\u0438\u043C \u0438\u044E\u043B\u044C\u0441\u043A\u0438\u043C
      \u0443\u0442\u0440\u043E\u043C \u0442\u044B \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0441\u044F
      \u0432 \u0441\u043B\u0435\u0437\u0430\u0445, \u0447\u0442\u043E \u0442\u0435\u043A\u043B\u0438
      \u043E\u0442 \u0430\u043B\u043B\u0435\u0440\u0433\u0438\u0438 \u043D\u0430
      \u043F\u044B\u043B\u044C \u0432\u043E\u043A\u0440\u0443\u0433 \u0442\u0432\u043E\u0435\u0433\u043E
      \u0432\u044B\u0436\u0430\u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u043B\u0438\u043C\u043E\u043D,
      \u043F\u043E\u0441\u043B\u0435 12 \u0447\u0430\u0441\u043E\u0432 \u0441\u043D\u0430
      \u0442\u0435\u043B\u0430"
