  - nodeId: 1
    speakerId: 
    initialized: 0
    speakerIsThis: 0
    overWriteValues: 0
    text: sitting in your office chair, you watched them with your yellow eyes, your
      gaze glinting.
    initFromScriptableObject: 0
    speaker: {fileID: 0}
    speakerGameObject: {fileID: 0}
    speakerName: 
    speakerPortrait: {fileID: 0}
    useSpriteAtlas: 0
    spriteAtlas: []
    spriteId: 0
    _speakerVoiceClips: []
    material: {fileID: 0}
    onNodeStart:
      m_PersistentCalls:
