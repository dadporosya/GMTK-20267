        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: no, i dont smoke anymore...
          m_BoolArgument: 0
        m_CallState: 2
  - m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 84563711}
        m_TargetAssemblyTypeName: InvokableMethods, Assembly-CSharp
        m_MethodName: SendMonologueTextAngel
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: yes, but your life is already smoked away/i followed
            you along trails of ash, watched through sky the elusive direction of
            your gaze/you so often.../stared at your hands.../as if you were examining
            something, as if you were searching for something in them...
          m_BoolArgument: 0
        m_CallState: 2
  - m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 84563711}
        m_TargetAssemblyTypeName: InvokableMethods, Assembly-CSharp
        m_MethodName: SendMonologueTextPlayer
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: but i never found it/i thought i was the chosen one/i
            was searching for runic patterns on my palms.../but it seems i was one
            of those whose hands were never kissed by god
          m_BoolArgument: 0
        m_CallState: 2
  - m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 84563711}
        m_TargetAssemblyTypeName: InvokableMethods, Assembly-CSharp
        m_MethodName: SendMonologueTextAngel
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: they reek of cigarette smoke forever now, and even here
            i can smell that acrid scent...
          m_BoolArgument: 0
        m_CallState: 2
  - m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 84563711}
        m_TargetAssemblyTypeName: InvokableMethods, Assembly-CSharp
        m_MethodName: SendMonologueTextPlayer
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: a week ago i decided i didnt want to feel it anymore
            and threw my last pack of cigarettes into the azure of the pond i had
            loved since childhood.../it still lies there, dissolving in its gastric
            juice, serving as a scarecrow for pike and sharp-toothed fish, while
            the bond with my hands dissolved all throughout its maw
          m_BoolArgument: 0
        m_CallState: 2
  - m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 84563711}
        m_TargetAssemblyTypeName: InvokableMethods, Assembly-CSharp
        m_MethodName: SendMonologueTextAngel
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: and with those very hands you brought yourself here,
            to this place between yesterday and tomorrow.../you know, it was so disgusting
            to watch that red sludge stream down your body and carefully flood your
            ears so you wouldnt go deaf from the loud fading rhythm of your heart
          m_BoolArgument: 0
        m_CallState: 2
  - m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 84563711}
        m_TargetAssemblyTypeName: InvokableMethods, Assembly-CSharp
        m_MethodName: SendMonologueTextAngel
